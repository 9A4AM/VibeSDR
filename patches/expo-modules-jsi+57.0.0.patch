+    plist_path="${staging_dir}/${PACKAGE_NAME}.framework/Versions/A/Resources/Info.plist"
+  fi
+  if [[ -f "$plist_path" ]]; then
+    local lower_name
+    lower_name=$(echo "$PACKAGE_NAME" | tr '[:upper:]' '[:lower:]')
