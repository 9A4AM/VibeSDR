+  # VibeSDR patch (2026-09-17): SwiftPM derives the framework's CFBundleIdentifier from the
+  # PACKAGE DIRECTORY, which here is "apple" — so the embedded framework shipped as
+  # "apple.ExpoModulesJSI". App Store Connect's Apple-silicon check reads an "apple." bundle as a
+  # system framework, looks for it in macOS, and reports ITMS-90863 "links with libraries that
+  # aren't present in macOS: @rpath/ExpoModulesJSI.framework/ExpoModulesJSI" on every delivery
+  # (VibeSDR builds 296–302). Every other Expo prebuilt carries its own name
+  # (expomodulescore.ExpoModulesCore, expofont.ExpoFont …); this gives ExpoModulesJSI the same.
+  # Done on the staged copy before it is signed and embedded, for the flat (iOS/tvOS) and the
+  # versioned (macOS/Catalyst) bundle layouts.
+  local plist_path="${staging_dir}/${PACKAGE_NAME}.framework/Info.plist"
